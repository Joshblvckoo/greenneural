--- a/styles/globals.css
+++ b/styles/globals.css
@@ -5,6 +5,14 @@
 :root {
   --background: #ffffff;
   --foreground: #171717;
+
+  /* Sustainability accent palette — used sparingly for live-data emphasis
+     (pulse dots, gradient hero, "cleanest region" highlights) rather than
+     replacing the emerald/slate system already used across the app. */
+  --eco-leaf: #10b981;
+  --eco-canopy: #047857;
+  --eco-sky: #38bdf8;
+  --eco-soil: #78350f;
 }
 
 :root.dark {
@@ -12,8 +20,42 @@
   --foreground: #ededed;
 }
 
+html {
+  color-scheme: light;
+}
+
+html.dark {
+  color-scheme: dark;
+}
+
 body {
   background: var(--background);
   color: var(--foreground);
   font-family: Arial, Helvetica, sans-serif;
+  transition: background-color 200ms ease, color 200ms ease;
+}
+
+/* A gentle gradient wash used on hero/marketing sections to give the app a
+   living, sustainability-forward feel without leaning on a stock photo. */
+.eco-gradient-bg {
+  background-image:
+    radial-gradient(60% 60% at 15% 15%, color-mix(in srgb, var(--eco-leaf) 18%, transparent) 0%, transparent 60%),
+    radial-gradient(50% 50% at 85% 10%, color-mix(in srgb, var(--eco-sky) 14%, transparent) 0%, transparent 55%);
+}
+
+/* A small breathing dot to signal "this value is live", used next to
+   real-time metrics across the dashboard and demo. */
+@keyframes eco-pulse {
+  0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--eco-leaf) 55%, transparent); }
+  100% { box-shadow: 0 0 0 8px color-mix(in srgb, var(--eco-leaf) 0%, transparent); }
+}
+
+.eco-live-dot {
+  animation: eco-pulse 1.8s ease-out infinite;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .eco-live-dot {
+    animation: none;
+  }
 }
